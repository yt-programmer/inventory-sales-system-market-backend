# قيم الاختبارات بس (npm test بيقراها بدل .env)
NODE_ENV=test
TZ=Africa/Cairo
PORT=4001
MONGO_URI=mongodb://127.0.0.1:27017/minimarket_test
JWT_SECRET=test-secret-test-secret-test-secret-32
JWT_EXPIRES=12h
COOKIE_MAX_AGE_HOURS=12
COOKIE_SAMESITE=lax
ADMIN_USERNAME=admin
ADMIN_PASSWORD=1234
CORS_ORIGIN=http://localhost:5173
BCRYPT_ROUNDS=4
MAX_LOGIN_ATTEMPTS=3
LOCK_MINUTES=15
TRUST_PROXY=0
RATE_LIMIT_GLOBAL=100000
RATE_LIMIT_LOGIN=1000
BODY_LIMIT_KB=100
LOG_LEVEL=silent
